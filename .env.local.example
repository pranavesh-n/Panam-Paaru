# Convex Cloud Deployment URL (automatically generated when running 'npx convex dev')
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Google OAuth Credentials (configured in Convex Dashboard -> Settings -> Environment Variables)
# AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=your-google-client-secret
